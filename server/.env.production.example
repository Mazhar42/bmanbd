NODE_ENV=production
PORT=5000

# In production compose, mongo runs as internal service `mongo`.
MONGO_URI=mongodb://mongo:27017/bman

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRE=30d
REFRESH_TOKEN_EXPIRE_DAYS=30

CLIENT_URL=https://www.example.com
ADMIN_URL=https://admin.example.com
SERVER_PUBLIC_URL=https://api.example.com
ALLOWED_ORIGINS=https://www.example.com,https://admin.example.com
COOKIE_DOMAIN=.example.com
COOKIE_SAME_SITE=lax

# Local VPS media storage with compression (default configured behavior)
MEDIA_STORAGE=local

# OAuth providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.example.com/api/auth/oauth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://api.example.com/api/auth/oauth/facebook/callback
FACEBOOK_API_VERSION=v22.0

# Optional cloud media provider (leave blank for local VPS uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bman
