# Reject unknown domains / bots
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name _;

    return 444;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;

    server_name _;

    ssl_certificate /etc/letsencrypt/live/www.bmanbd.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.bmanbd.com/privkey.pem;

    ssl_reject_handshake on;

    return 444;
}


# HTTP → HTTPS redirect + Certbot
server {
    listen 80;
    listen [::]:80;

    server_name bmanbd.com www.bmanbd.com admin.bmanbd.com api.bmanbd.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}


# ==========================
# WWW
# ==========================

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name bmanbd.com www.bmanbd.com;

    ssl_certificate /etc/letsencrypt/live/www.bmanbd.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.bmanbd.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    client_max_body_size 50M;

    proxy_connect_timeout 300;
    proxy_send_timeout 300;
    proxy_read_timeout 300;

    proxy_buffers 16 16k;
    proxy_buffer_size 32k;

    location /api/ {
        proxy_pass http://server:5000;

        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /uploads/ {
        proxy_pass http://server:5000;

        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        proxy_pass http://client:80;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}


